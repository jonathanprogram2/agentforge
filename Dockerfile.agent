
FROM python:3.10-slim

WORKDIR /workspace

RUN python -m pip install --no-cache-dir pytest==9.1.1

COPY --chown=10001:10001 app/__init__.py app/evaluator.py ./app/
COPY --chown=10001:10001 benchmarks/ ./benchmarks/

RUN mkdir -p reports && chown 10001:10001 reports

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTEST_ADDOPTS="-p no:cacheprovider"

USER 10001:10001

CMD ["python", "-m", "app.evaluator"]
